# Banco de dados (MySQL)
DATABASE_URL=mysql://user:pass@host:3306/tami_forms

# Asaas (ASAAS_ENV: sandbox | production)
ASAAS_ENV=sandbox
ASAAS_API_KEY=troque-pela-chave-do-ambiente-correspondente

# Pagamento
PAYMENT_AMOUNT=39.90
PAYMENT_DUE_DAYS=2
PAYMENT_SUCCESS_URL=https://forms.nutritamilivalle.com.br/confirmationPayment

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
SMTP_FROM=Nutri Tamili Valle <contato@example.com>

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=troque-pela-chave
EVOLUTION_INSTANCE=Suporte Nutri Tamili Valle

# Alertas para o administrador
ADMIN_ALERT_EMAIL=admin@example.com

# Jobs internos (segredo longo e aleatório, mínimo 32 caracteres)
JOBS_TOKEN=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
JOBS_ENABLED=true

# Notificações
NOTIFY_EMAIL_ENABLED=true
NOTIFY_WHATSAPP_ENABLED=true

# Webhook do Asaas (segredo aleatório, mínimo 32 caracteres; o mesmo valor cadastrado no painel do Asaas)
ASAAS_WEBHOOK_TOKEN=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

# IA (Anthropic)
ANTHROPIC_API_KEY=troque-pela-chave-da-anthropic
ANTHROPIC_MODEL=claude-opus-5-5

# Acesso ao PlanA (segredo aleatório, mínimo 32 caracteres; trocar invalida as senhas temporárias ainda não usadas)
ACCESS_PASSWORD_SECRET=troque-por-outro-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
PLANA_APP_URL=https://plana.nutritamilivalle.com.br/
